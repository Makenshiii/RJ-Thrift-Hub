{
  "name": "rj-thrift-hub",
  "private": true,
  "workspaces": [
    "backend",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace backend\" \"npm run dev --workspace client\"",
    "seed": "npm run seed --workspace backend",
    "test": "npm run test --workspace backend",
    "lint": "eslint \"client/src/**/*.{js,jsx}\" \"backend/src/**/*.js\" \"backend/test/**/*.js\" \"shared/**/*.mjs\"",
    "build": "npm run build --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2"
  }
}
