{
  "info": {
    "_postman_id": "8b42d120-19ec-46dd-9b34-6bb082d6a5a1",
    "name": "RJ Thrift Hub Payments and AI API",
    "description": "Express endpoints only. Sign in through the Supabase client and provide a Supabase access token; no secrets are stored here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "idempotencyKey", "value": "postman-checkout-001" },
    { "key": "mayaWebhookSignature", "value": "" },
    { "key": "mayaWebhookTimestamp", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('API is healthy', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('ok'); });"]
        }
      }]
    },
    {
      "name": "Create Maya checkout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"idempotencyKey\":\"{{idempotencyKey}}\",\"shippingAddress\":{\"recipient\":\"Demo Shopper\",\"phone\":\"09171234567\",\"address\":\"12 Sample St\",\"city\":\"Manila\",\"postalCode\":\"1000\"}}"
        },
        "url": "{{baseUrl}}/checkout"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Checkout returns a hosted session or setup/business error', () => pm.expect([201,409,422,503]).to.include(pm.response.code));",
            "if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().data.id);"
          ]
        }
      }]
    },
    {
      "name": "Reconcile payment",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/orders/{{orderId}}/verify-payment"
      }
    },
    {
      "name": "Resume Maya payment",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/orders/{{orderId}}/retry-payment"
      }
    },
    {
      "name": "Maya webhook",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-maya-webhook-signature", "value": "{{mayaWebhookSignature}}" },
          { "key": "x-maya-webhook-timestamp", "value": "{{mayaWebhookTimestamp}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"id\":\"maya-payment-id\",\"paymentStatus\":\"PAYMENT_SUCCESS\",\"requestReferenceNumber\":\"{{orderId}}\"}"
        },
        "url": "{{baseUrl}}/webhooks/maya"
      }
    },
    {
      "name": "AI product discovery",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"prompt\":\"Something casual in size M under 300 pesos\"}" },
        "url": "{{baseUrl}}/ai/discover"
      }
    }
  ]
}
